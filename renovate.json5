{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: ['config:recommended', ':dependencyDashboard', ':semanticCommitsDisabled'],

	// Sandbox tuning: in production you'd typically want a release-age delay
	// (e.g. '14 days') to avoid picking up freshly-published versions, and a
	// schedule like 'before 6am on monday' to batch routine PRs. Here we run
	// hot so a triggered Renovate run can actually do something visible.
	minimumReleaseAge: '0 days',

	rangeStrategy: 'bump',
	rebaseWhen: 'conflicted',


	// Sandbox-only: always recreate PRs we've previously closed. Production
	// configs should leave this at the default 'auto', which respects user
	// intent (closing a Renovate PR signals "rejected, don't recreate"). Here
	// we want fast iteration, so closing-and-re-triggering should always
	// produce a fresh PR.
	recreateWhen: 'always',
	// Sandbox-only: disable rate limits so iteration isn't gated by Renovate's
	// own safety knobs. Counterintuitively, prHourlyLimit counts closed PRs
	// too within the last hour, so close-and-retrigger cycles burn through
	// the budget. Production configs SHOULD set these to reasonable values
	// (e.g. prHourlyLimit: 2-4, prConcurrentLimit: 5-10) to throttle PR
	// floods.
	prHourlyLimit: 0,
	prConcurrentLimit: 0,
	labels: ['dependencies'],
	dependencyDashboardTitle: 'Renovate Dependency Dashboard',
	packageRules: [
		{
			matchUpdateTypes: ['minor', 'patch'],
			matchDepTypes: ['devDependencies'],
			groupName: 'dev dependencies (minor + patch)',
		},
		{
			matchUpdateTypes: ['minor', 'patch'],
			matchDepTypes: ['dependencies'],
			groupName: 'prod dependencies (minor + patch)',
		},
		{
			// Rush workspace deps are local; never bump these.
			matchCurrentValue: '/^workspace:/',
			enabled: false,
		},
	],
	lockFileMaintenance: {
		enabled: true,
		schedule: ['before 6am on monday'],
	},
	vulnerabilityAlerts: {
		labels: ['security'],
		minimumReleaseAge: '0 days',
		schedule: ['at any time'],
	},

	// THE MAIN POINT OF THIS REPO.
	//
	// Renovate has no native Rush manager (renovatebot/renovate#3681).
	// Without this block, Renovate's npm manager modifies package.json files
	// but doesn't know about the Rush-consolidated lockfile at
	// `common/config/rush/pnpm-lock.yaml` (it expects per-package lockfiles
	// adjacent to each package.json). PRs land with package.json bumps but
	// no lockfile updates → every CI build fails at Rush's consistency check.
	//
	// `node common/scripts/install-run-rush.js update` is the Rush bootstrap
	// invocation: install-run-rush.js downloads the pinned Rush version into
	// common/temp/ and then runs `rush update`, which regenerates the
	// consolidated lockfile based on the current package.json contents.
	//
	// `executionMode: 'branch'` runs the command once per branch (not once
	// per individual dependency update), so a single regen handles the
	// whole batch.
	//
	// `fileFilters` is the allowlist of files Renovate will include in the
	// commit from post-task changes. The transient build state in
	// `common/temp/` is gitignored by Rush convention, so it doesn't need
	// explicit exclusion.
	//
	// The matching `RENOVATE_ALLOWED_COMMANDS` regex allowlist in
	// `.github/workflows/renovate.yml` is required — by default Renovate
	// refuses to execute any postUpgradeTask command.
	postUpgradeTasks: {
		// Three commands, run in sequence in the same shell environment:
		//
		// 1. `install-tool node 20.14.0` — installs a Rush-compatible Node
		//    version via containerbase. The Renovate `installTools`
		//    declarative config (Renovate 41+) doesn't honor a node version
		//    constraint (verified via Renovate discussion #26387 —
		//    `constraints.node` and `force.constraints.node` are both
		//    ignored by installTools); the maintainer's recommended pattern
		//    is to invoke `install-tool node X.Y.Z` directly. Without this,
		//    containerbase defaults to latest Node (24.x), which Rush
		//    rejects (rush.json's `nodeSupportedVersionRange` allows only
		//    Node 18 or 20). 20.14.0 is the bottom of the supported 20.x
		//    range — bump as needed if rush.json changes.
		//
		// 2. `install-tool npm` — materializes the npm CLI. Renovate's
		//    Docker image ships Node but not the npm CLI by default
		//    (Renovate's own npm manager uses pnpm internally and never
		//    shells out to npm). Rush's bootstrap script does `command -v
		//    npm` and aborts immediately if it can't find npm. `npm`
		//    requires `node` to be containerbase-installed first, which
		//    step 1 above provides.
		//
		// 3. `node common/scripts/install-run-rush.js update --bypass-policy`
		//    — the Rush bootstrap. Downloads the pinned Rush version, then
		//    runs `rush update` to regenerate
		//    `common/config/rush/pnpm-lock.yaml` from current package.json
		//    contents.
		//
		//    The `--bypass-policy` flag skips Rush's git-author email check
		//    (`gitPolicy.allowedEmailRegExps` in rush.json). That policy
		//    exists to catch humans with unprofessional commit emails, but
		//    bot tools doing automated lockfile maintenance can hit
		//    false-positives — the first Rush invocation in a run does
		//    policy validation before Renovate sets its bot identity, so
		//    the email check sees an unexpected value and aborts. Without
		//    --bypass-policy, the very first branch alphabetically
		//    processed will fail with: "Aborting, so you can go fix your
		//    settings. (Or use '--bypass-policy' to skip.)"
		commands: [
			'install-tool node 20.14.0',
			'install-tool npm',
			'node common/scripts/install-run-rush.js update --bypass-policy',
		],
		fileFilters: ['common/config/rush/pnpm-lock.yaml', 'common/config/rush/repo-state.json'],
		executionMode: 'branch',
	},
}
